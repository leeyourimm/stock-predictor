# 서버에만 두는 Secret. 프론트엔드/깃에 절대 포함하지 말 것 (.env 는 .gitignore)
DATABASE_URL=sqlite:///./data/predictor.db
KRX_ID=            # KRX 정보데이터시스템 계정 (pykrx 필수)
KRX_PW=
DART_API_KEY=      # https://opendart.fss.or.kr
ECOS_API_KEY=      # https://ecos.bok.or.kr/api
KIS_APP_KEY=       # 한국투자증권 Open API (14:00 장중 시세, 거래정지/관리종목 상태)
KIS_APP_SECRET=
ANTHROPIC_API_KEY= # 설명 생성용 (없으면 코드 템플릿 설명)
CLAUDE_MODEL=claude-sonnet-5-5
UNIVERSE_MARKETS=KOSPI,KOSDAQ
